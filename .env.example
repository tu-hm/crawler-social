# Local, gitignored configuration for crawler-social.
CRAWLER_PAGE_URL=https://www.facebook.com/YOUR_PUBLIC_PAGE
# CRAWLER_BROWSER_BINARY=/usr/bin/google-chrome
# CRAWLER_PROFILE_DIR=/home/tuhoang/.local/state/crawler-social/chrome/default
# CRAWLER_DB_PATH=data/social.db

# How the crawler reaches a logged-in browser.
#
#   launch  Playwright starts Chrome against CRAWLER_PROFILE_DIR. Warm that
#           profile once with `crawler login` before crawling.
#   cdp     Playwright attaches to a Chrome *you* started yourself. Use this
#           if signing in under `launch` gets challenged: a browser you
#           started by hand was never flagged as automated, so the login is
#           treated as an ordinary one.
#
# For cdp, start Chrome yourself first:
#   google-chrome --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/.local/state/crawler-social/chrome/default"
# log in to Facebook in that window, and leave it open.
# CRAWLER_ATTACH_MODE=launch
# CRAWLER_CDP_URL=http://127.0.0.1:9222

# Keep the automated browser consistent with the machine it runs on. A profile
# whose locale and timezone disagree with its IP is a cheap thing to notice.
# CRAWLER_LOCALE=en-US
# CRAWLER_TIMEZONE=Asia/Ho_Chi_Minh

# Local web viewer (`crawler serve`). It binds to loopback and opens the
# database read-only by default.
# CRAWLER_SERVE_HOST=127.0.0.1
# CRAWLER_SERVE_PORT=8765
# Required (>= 32 chars) only for non-loopback binds with --allow-remote:
# CRAWLER_SERVE_TOKEN=

# A default list of URLs to crawl, one per line. `crawler crawl` with no
# arguments reads it; headings ("Groups:") and # comments are ignored, so a
# hand-written list works as it is. --targets overrides it per run.
# CRAWLER_TARGETS_FILE=example.txt

# Long posts and comments. Comments are off by default: each one costs a
# permalink navigation, so ask for them only when you want them. `crawl --full`
# turns on everything below without editing this file.
# CRAWLER_TOP_COMMENTS=0          # top-level comments per post; 0 = none
# CRAWLER_COMMENTS_MAX_POSTS=10   # ceiling on permalink visits per run
# CRAWLER_EXPAND_TEXT=1           # click "See more" before capturing a post
# CRAWLER_INCLUDE_REPLIES=1       # store reply threads under their parent

# A feed carries neither a story's permalink nor its publication time --
# Facebook fills both in only once the pointer is over the timestamp. With
# this off, most group posts get no exact time and no id to visit for their
# comments, so leave it on unless you are debugging the capture itself.
# CRAWLER_HOVER_TIMESTAMPS=1
