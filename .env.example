# Local, gitignored configuration for crawler-social.
CRAWLER_PAGE_URL=https://www.facebook.com/YOUR_PUBLIC_PAGE
# CRAWLER_BROWSER_BINARY=/usr/bin/google-chrome
# CRAWLER_PROFILE_DIR=/home/tuhoang/.local/state/crawler-social/chrome/default
# CRAWLER_DB_PATH=data/social.db

# How the crawler reaches a logged-in browser.
#
#   launch  Playwright starts Chrome against CRAWLER_PROFILE_DIR. Warm that
#           profile once with `crawler login` before crawling.
#   cdp     Playwright attaches to a Chrome *you* started yourself. Use this
#           if signing in under `launch` gets challenged: a browser you
#           started by hand was never flagged as automated, so the login is
#           treated as an ordinary one.
#
# For cdp, start Chrome yourself first:
#   google-chrome --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/.local/state/crawler-social/chrome/default"
# log in to Facebook in that window, and leave it open.
# CRAWLER_ATTACH_MODE=launch
# CRAWLER_CDP_URL=http://127.0.0.1:9222

# Keep the automated browser consistent with the machine it runs on. A profile
# whose locale and timezone disagree with its IP is a cheap thing to notice.
# CRAWLER_LOCALE=en-US
# CRAWLER_TIMEZONE=Asia/Ho_Chi_Minh
